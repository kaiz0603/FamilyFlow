rules_version = '2';

// The rules are the backend (docs/DATA_MODEL.md). Anything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- users/{uid}: private profile ----
    match /users/{uid} {
      function ageOn(data) {
        return request.time.year() - data.birthYear;
      }
      function validName(data) {
        return data.displayName is string
          && data.displayName.size() >= 1 && data.displayName.size() <= 30;
      }
      function validLocale(data) {
        return data.locale in ['zh', 'en'];
      }
      function validNewProfile(data) {
        return data.keys().hasAll(['displayName', 'role', 'birthYear', 'locale', 'createdAt'])
          && data.keys().hasOnly(['displayName', 'role', 'birthYear', 'locale', 'familyId', 'createdAt'])
          && validName(data)
          && validLocale(data)
          && data.role in ['parent', 'child']
          && data.birthYear is int && data.birthYear >= 1900
          // Year-only age: someone 12 and some months can pass (docs/PRIVACY.md).
          && ageOn(data) >= (data.role == 'parent' ? 18 : 13)
          && data.get('familyId', null) == null
          && data.createdAt == request.time;
      }

      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validNewProfile(request.resource.data);
      // M2 will allow setting familyId when a membership doc exists.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'locale', 'familyId'])
        && validName(request.resource.data)
        && validLocale(request.resource.data)
        && request.resource.data.get('familyId', null) == null;
    }
  }
}
