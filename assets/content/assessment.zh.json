{
  "contentVersion": "1.1",
  "scale": ["非常不符合", "比较不符合", "不确定", "比较符合", "非常符合"],
  "forms": {
    "parent_self": [
      { "id": "w01", "dimension": "warmth", "reverse": false, "text": "孩子说话时，我会放下手里的事认真听。" },
      { "id": "w02", "dimension": "warmth", "reverse": false, "text": "我会直接对孩子说“我爱你”或“我为你骄傲”。" },
      { "id": "w03", "dimension": "warmth", "reverse": false, "text": "孩子心情不好时，我能察觉并主动关心。" },
      { "id": "w04", "dimension": "warmth", "reverse": false, "text": "我对孩子的兴趣和朋友感到好奇。" },
      { "id": "w05", "dimension": "warmth", "reverse": false, "text": "孩子做得好时，我会具体地表扬。" },
      { "id": "w06", "dimension": "warmth", "reverse": false, "text": "我们每周都有一起放松聊天的时间。" },
      { "id": "w07", "dimension": "warmth", "reverse": false, "text": "孩子犯错后，我会先安慰再讨论问题。" },
      { "id": "w08", "dimension": "warmth", "reverse": false, "text": "孩子可以放心地把烦恼告诉我。" },
      { "id": "w09", "dimension": "warmth", "reverse": true, "text": "孩子说话时，我常常一边看手机一边听。" },
      { "id": "w10", "dimension": "warmth", "reverse": true, "text": "孩子哭或生气时，我会叫孩子“别小题大做”。" },
      { "id": "w11", "dimension": "warmth", "reverse": true, "text": "我很少知道孩子最近在烦什么。" },
      { "id": "w12", "dimension": "warmth", "reverse": true, "text": "我生气时会对孩子说伤人的话。" },
      { "id": "d01", "dimension": "demandingness", "reverse": false, "text": "我会和孩子一起定下明确的家规。" },
      { "id": "d02", "dimension": "demandingness", "reverse": false, "text": "定规则时，我会解释原因。" },
      { "id": "d03", "dimension": "demandingness", "reverse": false, "text": "我对孩子的学习有明确、合理的期望。" },
      { "id": "d04", "dimension": "demandingness", "reverse": false, "text": "孩子答应的事，我会跟进是否做到。" },
      { "id": "d05", "dimension": "demandingness", "reverse": false, "text": "我知道孩子放学后去了哪里、和谁在一起。" },
      { "id": "d06", "dimension": "demandingness", "reverse": false, "text": "我要求孩子分担家务。" },
      { "id": "d07", "dimension": "demandingness", "reverse": false, "text": "我们对屏幕时间有约定，并且会遵守。" },
      { "id": "d08", "dimension": "demandingness", "reverse": false, "text": "规则被打破时，我会按事先说好的方式处理。" },
      { "id": "d09", "dimension": "demandingness", "reverse": true, "text": "只要孩子一坚持，我通常就会让步。" },
      { "id": "d10", "dimension": "demandingness", "reverse": true, "text": "家里的规则经常变，要看我当天的心情。" },
      { "id": "d11", "dimension": "demandingness", "reverse": true, "text": "孩子作业有没有做完，我一般不过问。" },
      { "id": "d12", "dimension": "demandingness", "reverse": true, "text": "孩子熬夜晚睡，我通常不管。" }
    ],
